{
  "name": "merakiandmirth",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "python3 -m http.server 4173",
    "serve": "python3 -m http.server 4173",
    "images:mobile": "node scripts/prepare-catalogue-images.mjs",
    "build:mobile": "npm run images:mobile && node scripts/build-web.mjs",
    "android:sync": "npm run build:mobile && node scripts/clean-android-web-assets.mjs && npx cap sync android",
    "android:build": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:open": "npx cap open android",
    "local:start": "node scripts/local/start.mjs",
    "local:stop": "SUPABASE_TELEMETRY_DISABLED=1 supabase stop",
    "local:seed": "node scripts/local/seed.mjs",
    "local:serve": "node scripts/local/serve.mjs",
    "local:test": "node scripts/local/test.mjs",
    "images:test": "node --test tests/product-images.test.mjs",
    "local:images": "node scripts/local/prepare-image-variants.mjs && node scripts/local/install-image-variants.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/share": "^8.0.1",
    "jspdf": "^4.2.1"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@supabase/supabase-js": "2.117.2",
    "supabase": "2.75.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "supabase": {
      "tar": "7.5.22"
    }
  }
}
